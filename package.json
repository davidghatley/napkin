{
  "name": "napkin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "napkin: a local canvas for real React components, edited live by a person and an agent over MCP.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/",
    "start": "node src/server.js --port 4810",
    "mcp": "node src/mcp.js",
    "demo": "DEMO_OUT=docs/demo node --test test/10-demo.test.js",
    "evidence:canvas": "EVIDENCE_OUT=docs/evidence node --test --test-force-exit test/14-canvas-look.test.js"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recast": "0.24.0"
  },
  "devDependencies": {
    "axe-core": "4.13.0"
  },
  "bin": {
    "napkin": "src/cli.js"
  }
}
