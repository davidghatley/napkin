{
  "name": "napkin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "napkin: a local canvas for real React components, edited live by a person and an agent over MCP.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "NODE_OPTIONS=\"--import=$PWD/test/helpers/cleanup.js\" node --test --test-concurrency=1 test/",
    "start": "node --max-semi-space-size=2 src/server.js --port 4810",
    "mcp": "node src/mcp.js",
    "demo": "DEMO_OUT=docs/demo node --test test/10-demo.test.js",
    "evidence:canvas": "EVIDENCE_OUT=docs/evidence node --test --test-force-exit test/14-canvas-look.test.js",
    "pretest": "find \"${TMPDIR:-/tmp}\" -maxdepth 1 -name 'napkin-*' -mmin +60 -exec rm -rf {} + 2>/dev/null; true"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recast": "0.24.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "axe-core": "4.13.0"
  },
  "bin": {
    "napkin": "src/cli.js"
  }
}
